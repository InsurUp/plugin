{
  "name": "@insurup/plugin",
  "version": "0.1.0",
  "description": "TypeScript authoring SDK for InsurUp plugins — typed config, context, and event hooks.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "sideEffects": false,
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./globals": {
      "types": "./src/globals.d.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "bun test"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/bun": "latest",
    "eslint": "^9",
    "jiti": "^2",
    "typescript": "^5",
    "typescript-eslint": "^8"
  }
}
